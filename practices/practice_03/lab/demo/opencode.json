{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "local-guide",
  "model": "lmstudio/qwen3.5-9b-mlx",
  "small_model": "lmstudio/qwen3.5-9b-mlx",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio local",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "lm-studio"
      },
      "models": {
        "qwen3.5-9b-mlx": {
          "name": "Qwen3.5 9B MLX 4bit (32k)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
